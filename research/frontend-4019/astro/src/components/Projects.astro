---
import {projects,copy} from '#sample/data.js';const {locale='en'}=Astro.props;
---
<h2>{copy[locale].projects}</h2><div class="grid">{projects.map(project=><article><img src="/work.svg" width="600" height="300" alt=""/><h3><a href="https://example.com/">{project}</a></h3><p>{copy[locale].intro}</p></article>)}</div>
