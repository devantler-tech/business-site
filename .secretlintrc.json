{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": [
              "/^postgres:\\/\\/portal_fixture_owner:fixture-only@localhost:5432\\/postgres\\?sslmode=disable'$/u",
              "/^postgres:\\/\\/portal_migrator:fixture-only@localhost:5432\\/portal_identity_test\\?sslmode=disable'$/u",
              "/^postgres:\\/\\/portal_runtime:fixture-only@localhost:5432\\/portal_identity_test\\?sslmode=disable'$/u",
              "/^postgres:\\/\\/runtime:private@db\\.example\\.invalid\\/app\\?sslmode=verify-full\",$/u",
              "/^postgres:\\/\\/runtime:private@db\\.example\\.invalid\\/app\\?sslmode=disable\",$/u",
              "/^postgres:\\/\\/portal_runtime:fixture-only@127\\.0\\.0\\.1:55444\\/portal_trial_0123456789abcdef0123456789abcdef\\?sslmode=disable\",$/u",
              "/^postgres:\\/\\/portal_runtime:fixture-only@127\\.0\\.0\\.1:%d\\/%s\\?sslmode=disable\",$/u",
              "/^postgres:\\/\\/portal_runtime:fixture-only@127\\.0\\.0\\.1:55444,remote\\.example\\.invalid:5432\\/portal_identity_test\\?sslmode=disable\",$/u",
              "/^postgres:\\/\\/portal_runtime:fixture-only@127\\.0\\.0\\.1:55444\\/portal_identity_test\\?sslmode=disable&options=-c\\+role=portal_runtime\",$/u"
            ]
          }
        }
      ]
    }
  ]
}
