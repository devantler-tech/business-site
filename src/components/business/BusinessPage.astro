---
import BusinessSite from './BusinessSite.astro';
import BusinessSupporting from './BusinessSupporting.astro';
import ProjectRedirect from './ProjectRedirect.astro';

const legacy = Astro.url.pathname.replace(/\/$/, '');
const anchor = legacy === '/projects/active' ? 'open-title' : legacy === '/projects/completed' ? 'research' : null;
const locale = Astro.url.pathname.startsWith('/da/') ? 'da' : 'en';
const section = Astro.url.pathname.split('/').filter(Boolean).at(-1);
---
{anchor ? <ProjectRedirect anchor={anchor} /> : section === 'about' || section === 'projects' ? <BusinessSupporting locale={locale} section={section} /> : <BusinessSite locale={locale} />}
