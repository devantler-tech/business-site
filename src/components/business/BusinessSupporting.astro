---
import { Image } from 'astro:assets';
import portrait from '../../assets/profile.jpg';
import BusinessLayout from './BusinessLayout.astro';
import BusinessProjects from './BusinessProjects.astro';
import ClientPortfolio from './ClientPortfolio.astro';
import { FEATURE_CLIENT_PORTFOLIO } from 'astro:env/server';
import { clientCopy } from './client-facing';
import { copy, type Locale } from './content';
import { supporting } from './supporting';
interface Props { locale: Locale; section: 'about' | 'projects' }
const { locale, section } = Astro.props;
const t = supporting[locale];
const homeCopy = copy[locale];
const home = locale === 'da' ? '/da/' : '/';
const about = section === 'about';
---
<BusinessLayout locale={locale} section={section} title={`${about ? t.aboutTitle : t.projectsTitle} | Devantler Tech`} description={about ? t.aboutDescription : t.projectsDescription}>
  <main id="main" class="container supporting-page">
    <div class="opening"><h1>{about ? t.aboutTitle : t.projectsTitle}</h1><p>{about ? t.aboutIntro : FEATURE_CLIENT_PORTFOLIO ? clientCopy[locale].projectsIntro : t.projectsIntro}</p></div>
    {about ? <>
      <section class="founder" aria-labelledby="founder-title">
        <Image src={portrait} alt="Nikolai Emil Damm" width={600} widths={[320, 600]} sizes="(max-width: 760px) 100vw, 320px" format="webp" loading="eager" />
        <div><p class="role">{t.founderRole}</p><h2 id="founder-title">Nikolai Emil Damm</h2><p>{t.founderText}</p><p>{t.founderNote}</p></div>
      </section>
      <section aria-labelledby="approach-title"><h2 id="approach-title">{t.approachTitle}</h2><div class="principles">{t.principles.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
      <section class="background" aria-labelledby="background-title"><h2 id="background-title">{t.backgroundTitle}</h2><p>{t.backgroundText}</p><div class="links"><a href="/pdfs/nikolai-emil-damm-cv.pdf" download>{t.cv}</a><a href="https://github.com/devantler">{t.github}</a><a href="/blog/">{homeCopy.blog}</a></div></section>
    </> : <>
      {FEATURE_CLIENT_PORTFOLIO ? <ClientPortfolio locale={locale} /> : <BusinessProjects locale={locale} />}
    </>}
    <a class="contact-link" href={`${home}#contact`}>{t.contact}</a>
  </main>
</BusinessLayout>
<style>
  .supporting-page { padding-block: 4rem; }
  .opening { max-width: 820px; padding-bottom: 3rem; }
  h1 { font-size: clamp(2.3rem, 5vw, 4rem); }
  .opening p { font-size: 1.2rem; margin-top: 1.5rem; max-width: 650px; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  h3 { font-size: 1.2rem; }
  section { padding-block: 2.5rem; border-top: 1px solid var(--line); }
  .founder { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 4rem; align-items: center; }
  .founder img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: center 35%; border-radius: 8px; border: 1px solid var(--line); }
  .founder p:not(.role) { margin-top: 1.2rem; max-width: 660px; }
  .role { color: var(--accent); font-size: .85rem; margin-bottom: .5rem; }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 2rem; }
  .principles p, .family article > p:last-child { margin-top: 1rem; font-size: .95rem; }
  .background > p, .section-intro { margin-top: 1.2rem; max-width: 760px; }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 2rem; margin-top: 1.25rem; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); text-underline-offset: .2em; }
  .featured { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 3rem; align-items: center; margin-top: 2rem; }
  .featured p, .project-row p { margin-block: 1rem; }
  .featured img { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 8px; }
  .project-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 3rem; border-top: 1px solid var(--line); padding-top: 1.75rem; margin-top: 2rem; }
  .project-row p { margin-top: 0; max-width: 660px; }
  .family { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 2rem; }
  .note { font-size: .8rem; margin-top: 1rem; }
  .contact-link { background: var(--accent); color: var(--accent-ink); border-radius: 6px; padding: .75rem 1.25rem; font-weight: 600; }
  .contact-link:hover { color: var(--accent-ink); background: var(--accent-hover); }
  @media (max-width: 760px) { .supporting-page { padding-block: 2.5rem; } .founder, .principles, .featured, .project-row, .family { grid-template-columns: 1fr; gap: 1.5rem; } .founder img { max-width: 320px; } .opening { padding-bottom: 2rem; } section { padding-block: 2rem; } }
</style>
