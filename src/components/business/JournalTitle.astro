---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { journalIntro } from './journal-config.js';

const path = Astro.url.pathname.replace(/\/$/, '');
const journal = /^\/blog(?:\/|$)/.test(path);
const reading = journal && Astro.locals.starlightBlog.posts.some(post => post.href.replace(/\/$/, '') === path);
const mainArchive = /^\/blog(?:\/\d+)?$/.test(path);
---
{
  journal && !reading ? (
    <div class="journal-intro">
      <h1 id="_top">{mainArchive ? 'Journal' : Astro.locals.starlightRoute.entry.data.title}</h1>
      <p>{journalIntro}</p>
    </div>
  ) : <Default />
}
