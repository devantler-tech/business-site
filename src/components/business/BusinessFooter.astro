---
import { company, companyIdentityEnabled, copy, inquiryUrl, type Locale } from './content';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = copy[locale];
const prefix = locale === 'da' ? '/da' : '';
---
<footer data-business-footer class="business-footer container">
  <div><a class="brand" href={`${prefix}/`}>{company.name}</a><p>{t.footerIdentity}</p><p>{t.footer}</p>{companyIdentityEnabled && <><p>CVR {company.cvr} · {t.registrationType}</p><a class="company-email" href={inquiryUrl}>{company.email}</a></>}</div>
  <div class="links"><a href={`${prefix}/about/`}>{t.aboutNav}</a><a href={`${prefix}/projects/`}>{t.projectsNav}</a>{companyIdentityEnabled && <a href={`${prefix}/company/`}>{locale === 'da' ? 'Virksomhedsoplysninger' : 'Company information'}</a>}<a href={`${prefix}/#contact`}>{t.contact}</a></div>
</footer>
<style>
  .business-footer { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; padding-block: 2.5rem; border-top: 1px solid var(--line); font-family: 'Studio Inter', system-ui, sans-serif; color: var(--ink); text-align: left; }
  .brand { font-size: 1.15rem; font-weight: 600; text-decoration: none; color: var(--ink); }
  p { margin: .4rem 0 0; font-size: .8rem; color: var(--muted); }
  .company-email { display: inline-flex; align-items: center; min-height: 44px; font-size: .8rem; color: var(--ink); text-underline-offset: .2em; overflow-wrap: anywhere; }
  .links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; font-size: .8rem; color: var(--ink); text-underline-offset: .2em; }
  a:hover { color: var(--accent); }
  @media (max-width: 760px) { .business-footer { flex-direction: column; gap: .75rem; } }
</style>
