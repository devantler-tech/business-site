---
import { customerScope } from './customer-scope';
import type { Locale } from './business-copy';
interface Props { locale: Locale; heading?: 'h2' | 'h3' }
const t = customerScope[Astro.props.locale];
const Heading = Astro.props.heading ?? 'h2';
---
<div class="customer-scope" data-customer-scope>
  <Heading>{t.title}</Heading><p>{t.audience}</p><p class="boundary">{t.boundary}</p>
  <slot />
</div>
<style>
  .customer-scope { max-width: 700px; margin-block: 2rem; }
  h2, h3 { font-size: 1.1rem; }
  p { margin-top: .75rem; }
  .boundary { font-size: .85rem; }
</style>
